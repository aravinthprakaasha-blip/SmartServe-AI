rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global fallback rule - deny all unhandled by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Rules: Users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Live Restaurant Dishes Collection: Authenticated restaurant staff can read and modify
    match /dishes/{dishId} {
      allow read, write: if isSignedIn();
    }

    // Live Real-Time Sales & Service Records: Authenticated staff can read, log, and update
    match /salesRecords/{saleId} {
      allow read, write: if isSignedIn();
    }

    // Live Inventory Raw Ingredients: Authenticated staff can track & update stock
    match /ingredients/{ingredientId} {
      allow read, write: if isSignedIn();
    }

    // Live Food Waste Records: Authenticated kitchen crew can read and append waste logs
    match /wasteRecords/{recordId} {
      allow read, write: if isSignedIn();
    }

    // Live Scheduled Events & Crowds: Authenticated users can view and schedule
    match /restaurantEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    // Live System & Operating Parameters
    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
